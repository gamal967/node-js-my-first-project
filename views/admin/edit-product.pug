
extends ../layouts/main-layout.pug

block style 
    link(rel="stylesheet", href="/css/shop.css")
    link(rel="stylesheet", href="/css/admin.css")

block content 
    main.main-content 
        section.admin-card
            if errorMessage && errorMessage != ''
                div.errorMessage #{errorMessage}

            form(action=`${editing ? '/admin/edit-product' : '/admin/product'}`, method="POST", id="add-product-form").product-form
                label(for="title") Product Name
                input.input(
                type="text"
                ,class=(validationError.find(e=> e.path === 'title') ? 'invalid' : '')
                , name="title"
                , id="title"
                , placeholder="Product name"
                , value=editing ? product.title : oldInputs.title
                , required)

                label(for="imageUrl") Product Image
                input.input(
                    type="text"
                    class=(validationError.find(e=> e.path === 'imageUrl') ? 'invalid' : '')
                    , name="imageUrl"
                    , id="imageUrl"
                    , placeholder="Product image URL" 
                    ,value=editing ? product.imageUrl : oldInputs.imageUrl
                    , required)

                label(for="price") Price
                input.input(
                    type="number"
                    class=(validationError.find(e=> e.path === 'price') ? 'invalid' : '')
                    , name="price"
                    , id="price"
                    , placeholder="Product price"
                    , step="0.01" 
                    ,value=editing ? product.price : oldInputs.price
                    , required)

                input(type="hidden", name="_csrf", value=csrfToken)

                label(for="description") Description
                textarea.input(
                    name="description" 
                    ,class=(validationError.find(e=> e.path === 'description') ? 'invalid' : '')
                    ,id="description"
                    ,rows="3" cols="50" 
                    ,placeholder="Product description" ) #{editing ? product.description : oldInputs.description}
                if editing
                    input(type="hidden", name="productId", value=""+product._id) 
                button.submit(type="submit") #{editing ? 'Update Product' : 'Add Product'}
