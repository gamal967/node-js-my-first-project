
extends ../layouts/main-layout.pug
block style 
    link(rel="stylesheet", href="/css/shop.css")
block content
                        
        main 
            if prods.length > 0
                div.grid
                    each product in prods
                        article.card.product-item
                            header.card__header
                                h1.product_title #{product.title}
                            div.card_image
                                img(src='/'+product.imageUrl, alt=product.title)
                            div.card__content
                                h2.product-price $#{product.price}
                                p.product_description #{product.description}
                            div.card_actions 
                                a(href="/admin/edit-product/"+product._id+"?edit=true" ).btn Edit

                                input(type="hidden" name="productId" value=product._id)
                                input(type="hidden", name="_csrf", value=csrfToken)
                                button.btn(type="button",onclick="deleteProduct(this)") Delete
            else
                h1 No Product Found
        script(src="/js/admin.js")
