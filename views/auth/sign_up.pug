extends ../layouts/main-layout.pug

block style
    link(rel="stylesheet", href="/css/auth.css")

block content
    main.main-content.auth-page
        section.auth-card
            .auth-card__header
                h1.auth-card__title Create Account
            if errorMessage && errorMessage != ''
                div.errorMessage #{errorMessage}

            form.auth-form(action="/signup", method="POST")
                .form-group
                    label(for="email") Email
                    input#email(
                        class=(validationError.find(e=> e.path === 'email') ? 'invalid' : '')
                        type="email",
                        name="email"
                        ,value=oldInputs.email
                        , placeholder="Enter your email"
                        , required)

                .form-group
                    label(for="password") Password
                    input#password(
                        class=(validationError.find(e=> e.path === 'password') ? 'invalid' : ''),
                        type="password"
                        , name="password"
                        , placeholder="Enter your password"
                        , required)

                .form-group
                    label(for="confirmPassword") Confirm Password
                    input#confirmPassword(
                        class=(validationError.find(e=> e.path === 'confirmPassword') ? 'invalid' : '')
                        type="password"
                        , name="confirmPassword"
                        , placeholder="Confirm your password"
                        , required)

                input(type="hidden", name="_csrf", value=csrfToken)
                button.auth-btn(type="submit") Sign Up

            p.auth-card__footer
                | Already have an account?
                a(href="/login") Log in

