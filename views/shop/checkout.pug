extends ../layouts/main-layout.pug
block style
	link(rel="stylesheet", href="/css/cart.css")

block content
	main.checkout-container
		h1.checkout-title Checkout

		if products.length > 0
			ul.checkout-list
				each product in products
					li.checkout-item
						span.checkout-item__name #{product.productId.title || 'No Title'}
						span.checkout-item__quantity x#{product.quantity || 0}

			div.checkout-total
				span.checkout-total__label Total
				span.checkout-total__price $#{totalSum.toFixed(2)}
			div.order
				button.btn(
					type='button'
					, id='order-btn'
					, data-session-id=sessionId
					, data-publishable-key=publishableKey
				) Order Now
				script(src="https://js.stripe.com/v3/")
				script(src="/js/checkout.js")
		else
			p.checkout-empty Your cart is empty.
